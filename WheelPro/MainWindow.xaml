<Window x:Class="WheelPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Wheel Pro" Icon="/Assets/WheelPro.ico" Height="900" Width="1240" Background="#F4F6FA" Foreground="#172033">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#F8FAFD"/><Setter Property="Foreground" Value="#263247"/><Setter Property="BorderBrush" Value="#D9E0EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FBFCFE"/><Setter Property="BorderBrush" Value="#D3DBE8"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="Border" x:Key="Panel"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E0E6F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
    <Style TargetType="TextBlock" x:Key="FieldLabel"><Setter Property="Foreground" Value="#6D788C"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/></Style>
  </Window.Resources>
  <Grid Margin="24"><Border Style="{StaticResource Panel}" CornerRadius="28" Padding="28"><Grid>
    <Grid x:Name="SearchView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,2,0,22"><TextBlock Text="WHEEL LIBRARY" Foreground="#2463EB" FontWeight="Bold" FontSize="11"/><TextBlock Text="Find your racing wheel" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock Text="Search brands and models to load a controller profile." Foreground="#697589" FontSize="13"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="SEARCH FOR WHEEL" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="Open" Background="#2F70F5" Foreground="White" BorderBrush="#2F70F5" Click="OpenStudio_Click"/><Button x:Name="AddWheelButton" DockPanel.Dock="Right" Content="Add wheel" IsEnabled="False" Click="AddDetectedWheel_Click"/><Button DockPanel.Dock="Right" Content="Scan PC" Click="ScanConnectedWheels_Click"/><TextBox x:Name="ControllerSearch" Height="44" Padding="14,0" VerticalContentAlignment="Center" FontSize="15" KeyDown="ControllerSearch_KeyDown" TextChanged="ControllerSearch_TextChanged"/></DockPanel><TextBlock x:Name="SearchStatus" Foreground="#697589" FontSize="12" Margin="0,7,0,0" Text="Scan this PC to detect a connected wheel."/></StackPanel>
      <ListBox x:Name="SuggestionList" Grid.Row="2" Margin="0,4,0,0" MaxHeight="260" Background="White" BorderBrush="#D8E0EC" BorderThickness="1" Visibility="Collapsed" SelectionChanged="SuggestionList_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="13,9"/></Style></ListBox.ItemContainerStyle></ListBox>
      <StackPanel Grid.Row="3" Margin="0,30,0,0"><DockPanel Margin="0,0,0,5"><Button DockPanel.Dock="Right" Content="Show saved presets" Click="ShowSavedPresets_Click" Padding="12,6"/><TextBlock Text="SAVED WHEELS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Cached profiles, downloaded drivers and saved wheel presets" Foreground="#7B8698" FontSize="13" Margin="0,5,0,15"/><ListBox x:Name="SavedWheelList" ItemsSource="{Binding SavedWheels}" Background="Transparent" BorderThickness="0"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="220" Height="156" Style="{StaticResource Panel}" Margin="0,0,14,14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding Brand}" Foreground="#2463EB" FontWeight="Bold" FontSize="11"/><TextBlock Text="{Binding Model}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding Status}" Foreground="#758197" FontSize="12" Margin="0,8,0,0"/></StackPanel><Button Grid.Row="1" Tag="{Binding}" Click="ToggleFavourite_Click" Content="&#9733;" Width="36" Height="29" Padding="0" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptySavedWheels" Text="No saved wheels yet." Foreground="#7B8698" Visibility="Collapsed"/></StackPanel>
    </Grid>
    <Grid x:Name="StudioView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,2,0,22"><Button DockPanel.Dock="Right" Content="Export profile" Background="#2F70F5" Foreground="White" BorderBrush="#2F70F5" Click="ExportProfile_Click"/><StackPanel><TextBlock Text="WHEEL PROFILE" Foreground="#2463EB" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="ControllerTitle" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock x:Name="ControllerDetails" Foreground="#697589" FontSize="13"/></StackPanel></DockPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="CALIBRATION AND SENSITIVITY" Style="{StaticResource FieldLabel}"/><TextBlock Text="Steering sensitivity" Margin="0,18,0,2"/><Slider x:Name="SensitivitySlider" Minimum="0.4" Maximum="3" Value="1.15" ValueChanged="SettingsChanged"/><TextBlock x:Name="SensitivityText" Text="1.15x" Foreground="#2463EB" HorizontalAlignment="Right"/><TextBlock Text="Centre deadzone" Margin="0,14,0,2"/><Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="20" Value="1" ValueChanged="SettingsChanged"/><TextBlock x:Name="DeadzoneText" Text="1%" Foreground="#2463EB" HorizontalAlignment="Right"/><TextBlock Text="Controller behaviour in games" Margin="0,14,0,4"/><ComboBox x:Name="OutputMode" SelectedIndex="0" SelectionChanged="OutputMode_SelectionChanged"><ComboBoxItem Content="Native wheel (DirectInput / HID)"/><ComboBoxItem Content="Xbox controller — A selects, B goes back"/></ComboBox><TextBlock x:Name="CompatibilityStatus" Foreground="#697589" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><Button x:Name="InstallVirtualDriverButton" Content="Install virtual-controller driver" Click="InstallVirtualDriver_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}" BorderBrush="#A9C7F5" Margin="0,14,0,0"><StackPanel><TextBlock Text="GAME SESSION LOCK" Style="{StaticResource FieldLabel}"/><TextBlock Text="Gaming platform" Margin="0,9,0,4"/><ComboBox x:Name="GamePlatform" SelectedIndex="0" SelectionChanged="GamePlatform_SelectionChanged"><ComboBoxItem Content="Any Windows game"/><ComboBoxItem Content="Steam"/><ComboBoxItem Content="EA app / EA Play"/></ComboBox><TextBlock x:Name="GameSessionStatus" Foreground="#24589B" TextWrapping="Wrap" Margin="0,9,0,4"/><WrapPanel><Button Content="Choose game .exe" Click="ChooseGameExecutable_Click"/><Button Content="Refresh online mapping" Click="RefreshOnlineMapping_Click"/><Button Content="Clear game lock" Click="ClearGameLock_Click"/></WrapPanel><TextBlock x:Name="GameIntelligenceStatus" Foreground="#697589" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Text="Online game intelligence waits for a selected game."/></StackPanel></Border><Border Style="{StaticResource Panel}" BorderBrush="#E7CF8F" Margin="0,14,0,0"><StackPanel><TextBlock Text="FORCE FEEDBACK" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ForceFeedbackStatus" Foreground="#806019" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="DRIVER AND PROFILE CACHE" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="DriverStatus" Foreground="#27784A" TextWrapping="Wrap" Margin="0,9,0,4"/><WrapPanel><Button Content="Open official driver page" Click="OpenOfficialDriverPage_Click"/><Button Content="Cache this wheel profile" Click="PrepareDriver_Click"/></WrapPanel></StackPanel></Border></StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="LIVE CONTROLLER TEST" Style="{StaticResource FieldLabel}"/><TextBlock Text="Use the physical wheel to test its inputs" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Turn the wheel, press a pedal, move the D-pad, or press any button. The tiles update as Windows receives each input." Foreground="#697589" FontSize="13" TextWrapping="Wrap"/></StackPanel>
          <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,10"><Canvas Width="620" Height="360"><Canvas x:Name="WheelGraphic" RenderTransformOrigin="0.5,0.5"><Canvas.RenderTransform><RotateTransform x:Name="WheelRotation"/></Canvas.RenderTransform><Ellipse Canvas.Left="190" Canvas.Top="12" Width="240" Height="240" Stroke="#263247" StrokeThickness="24"/><Ellipse Canvas.Left="270" Canvas.Top="92" Width="80" Height="80" Fill="#2463EB"/><Rectangle Canvas.Left="297" Canvas.Top="42" Width="26" Height="90" Fill="#263247"/><Rectangle Canvas.Left="297" Canvas.Top="132" Width="26" Height="70" Fill="#263247" RenderTransformOrigin="0.5,0"><Rectangle.RenderTransform><RotateTransform Angle="120"/></Rectangle.RenderTransform></Rectangle><Rectangle Canvas.Left="297" Canvas.Top="132" Width="26" Height="70" Fill="#263247" RenderTransformOrigin="0.5,0"><Rectangle.RenderTransform><RotateTransform Angle="-120"/></Rectangle.RenderTransform></Rectangle><Ellipse x:Name="WheelButtonA" Canvas.Left="380" Canvas.Top="112" Width="28" Height="28" Fill="#DCE6F8"/><Ellipse x:Name="WheelButtonB" Canvas.Left="410" Canvas.Top="82" Width="28" Height="28" Fill="#DCE6F8"/><Ellipse x:Name="WheelButtonX" Canvas.Left="350" Canvas.Top="82" Width="28" Height="28" Fill="#DCE6F8"/><Ellipse x:Name="WheelButtonY" Canvas.Left="380" Canvas.Top="52" Width="28" Height="28" Fill="#DCE6F8"/><Rectangle x:Name="DpadGraphic" Canvas.Left="205" Canvas.Top="87" Width="58" Height="58" RadiusX="9" RadiusY="9" Fill="#DCE6F8"/><TextBlock Canvas.Left="218" Canvas.Top="104" Text="D-PAD" Foreground="#263247" FontSize="10" FontWeight="Bold"/><TextBlock Canvas.Left="300" Canvas.Top="121" Text="WHEEL" Foreground="White" FontSize="11" FontWeight="Bold"/></Canvas><TextBlock Canvas.Left="278" Canvas.Top="263" Text="LIVE WHEEL" Foreground="#6D788C" FontSize="11" FontWeight="Bold"/><Rectangle x:Name="ClutchPedalGraphic" Canvas.Left="220" Canvas.Top="292" Width="45" Height="56" RadiusX="7" RadiusY="7" Fill="#DCE6F8" Visibility="Collapsed"/><Rectangle x:Name="BrakePedalGraphic" Canvas.Left="285" Canvas.Top="292" Width="45" Height="56" RadiusX="7" RadiusY="7" Fill="#DCE6F8"/><Rectangle x:Name="AcceleratorPedalGraphic" Canvas.Left="350" Canvas.Top="292" Width="45" Height="56" RadiusX="7" RadiusY="7" Fill="#DCE6F8"/><Border x:Name="HShifterGraphic" Canvas.Left="475" Canvas.Top="270" Width="75" Height="75" BorderBrush="#263247" BorderThickness="5" Visibility="Collapsed"><TextBlock Text="H&#x0a;1 3 5&#x0a;2 4 R" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border></Canvas></Viewbox>
          <StackPanel Grid.Row="2"><TextBlock Text="CONTROLS DETECTED FOR THIS PROFILE" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/><Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Steering and pedals" FontWeight="SemiBold"/><TextBlock x:Name="PedalGroupControls" Foreground="#6D788C" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border><Border x:Name="HShifterGroup" Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="H-pattern shifter" FontWeight="SemiBold"/><TextBlock Text="Reverse · Gears 1–6 · Handbrake" Foreground="#6D788C" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}" Padding="12"><StackPanel><TextBlock Text="All wheel buttons" FontWeight="SemiBold"/><TextBlock x:Name="ButtonGroupControls" Foreground="#6D788C" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
        </Grid></Border>
      </Grid><StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StudioStatus" Foreground="#697589"/><TextBlock x:Name="CalibrationMonitorStatus" Foreground="#27784A" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Text="Local calibration learning starts when this wheel sends input."/></StackPanel>
    </Grid>
  </Grid></Border></Grid>
</Window>
